#!/bin/bash
# Strip Co-authored-by trailers injected by IDE extensions or GitHub Copilot.
# Uses sed -i.bak for macOS/BSD portability, then cleans up the backup.
sed -i.bak \
  -e '/^Co-authored-by: Cursor/d' \
  -e '/^Co-authored-by: Copilot/d' \
  -e '/^Co-authored-by:.*copilot@users\.noreply\.github\.com/d' \
  "$1" && rm -f "$1.bak"
